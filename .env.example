# Upstream service URLs
DATA_API_BASE=https://propiq-data-api-429012647952.me-central1.run.app
CHARTS_API_BASE=https://propiq-charts-api-429012647952.me-central1.run.app
CHARTS_IMG_BASE=https://propiq-charts-img-429012647952.me-central1.run.app

# LLM — Vertex AI primary (uses GCP ADC, no key needed)
ANTHROPIC_MODEL=claude-sonnet-4-6
VERTEX_PROJECT=crowdproperty-440707
VERTEX_REGION=us-east5

# LLM — Direct Anthropic API fallback (optional, enables fallback on 429/rate limits)
# On Cloud Run: mounted from Secret Manager (anthropic-api-key)
# Locally: set here or leave empty to use Vertex AI only
ANTHROPIC_API_KEY=

# Output
OUTPUT_DIR=./output

# GCP (for BigQuery scout_news access)
GCP_PROJECT=crowdproperty-440707
